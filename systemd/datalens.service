[Unit]
Description=DataLens Production Heartbeat Service
After=network.target

[Service]
Type=simple
User=shaik
WorkingDirectory=/mnt/d/projects/datalens
ExecStart=/usr/bin/python3 /mnt/d/projects/datalens/scripts/heartbeat_worker.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
