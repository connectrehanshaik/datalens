[Unit]
Description=DataLens Production Worker & Metrics Service
Documentation=https://github.com/connectrehanshaik/datalens
After=network.target

[Service]
Type=simple
User=shaik
WorkingDirectory=/mnt/d/projects/datalens
ExecStart=/usr/bin/python3 /mnt/d/projects/datalens/scripts/heartbeat_worker.py
Restart=always
RestartSec=3

# Resource Isolation (CGroup v2)
MemoryMax=64M
CPUQuota=20%

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
